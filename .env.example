# Copy this file to .env and adjust the values.
# Generate a real secret key with:  python -c "import secrets; print(secrets.token_hex(32))"

# Which configuration class to load: development | testing | production
FLASK_CONFIG=development

# Session/CSRF signing key. REQUIRED in production; the app refuses to start
# in production with the built-in development key.
SECRET_KEY=6f1c2e8a94d05b7f3a61c9e2d8b4a0f57e3c1d9b6a84f20c5e7d31b9a6c48e02

# Optional: override the database location. Defaults to instance/attendance.db
# Example for PostgreSQL later: postgresql+psycopg://user:pass@localhost/attendance
# DATABASE_URL=sqlite:///C:/data/attendance.db

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
